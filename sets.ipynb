   "source": [
    "print( \"       SETS      \")\n",
    "se={1,2,3,4,5}\n",
    "se.add(10)\n",
    "print(se)\n",
    "se.update([20,30])\n",
    "print(se)\n",
    "se.remove(30)\n",
    "print(se)\n",
    "se.discard(3)\n",
    "print(se)\n",
    "se1={3,1,4,40 ,20}\n",
    "se2=se.union(se1)\n",
    "print(se2)\n",
    "se3=se2.intersection(se1)\n",
    "print(se3)\n",
    "se4=se2.difference(se1)\n",
    "print(se4)"
   ]
